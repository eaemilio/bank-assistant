# Configuración del Correo Electrónico
EMAIL_USER=tu_email@gmail.com

# OPCIÓN 1: Usar contraseña de aplicación (método tradicional)
# Descomenta la siguiente línea si NO usas OAuth2:
# EMAIL_PASSWORD=tu_contraseña_de_aplicacion

# OPCIÓN 2: Usar OAuth2 (recomendado si no tienes acceso a contraseñas de aplicación)
# Cambia a "true" para habilitar OAuth2:
USE_OAUTH2=false

# Credenciales OAuth2 de Google Cloud Console (solo si USE_OAUTH2=true)
# Consulta OAUTH2_SETUP.md para obtener estas credenciales
GMAIL_OAUTH2_CLIENT_ID=
GMAIL_OAUTH2_CLIENT_SECRET=
GMAIL_OAUTH2_REDIRECT_URI=http://localhost

# Configuración del servidor IMAP
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_TLS=true

# Carpeta del correo donde buscar (INBOX es por defecto)
EMAIL_FOLDER=INBOX

# Remitentes del banco (para filtrar correos) - separados por comas si son varios
BANK_EMAIL_SENDERS=estado.decuenta@no-responder.bancopromerica.com.gt,estado.decuenta@bancopromerica.com.gt

# Palabras clave para identificar estados de cuenta
EMAIL_SUBJECT_KEYWORDS=estado de cuenta,state,tarjeta de credito

# Intervalo de chequeo en minutos
CHECK_INTERVAL_MINUTES=5

# Carpeta donde guardar PDFs descargados
DOWNLOAD_FOLDER=./downloads

# Carpeta donde guardar logs
LOG_FOLDER=./logs

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Configuración de Notion
# Para obtener tu API key: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_tu_api_key_de_notion
# ID de la base de datos donde guardar la información
# El ID está en la URL de tu base de datos: notion.so/[workspace]/[DATABASE_ID]?v=...
NOTION_DATABASE_ID=tu_database_id_de_notion

