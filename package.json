{
  "name": "bank-statement-automation",
  "version": "1.1.0",
  "description": "Automatización de procesamiento de estados de cuenta bancarios desde correo electrónico",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "check": "node src/test-config.js",
    "test:notion": "node src/test-notion.js",
    "setup-oauth": "node src/setup-oauth.js",
    "setup-oauth-ssm": "node src/setup-oauth-ssm.js",
    "lambda:invoke": "node src/lambda.js",
    "lambda:deploy": "cd infrastructure && pwsh -File deploy.ps1",
    "lambda:deploy:bash": "cd infrastructure && bash deploy.sh",
    "lambda:check": "cd infrastructure && pwsh -File test-prerequisites.ps1",
    "lambda:logs": "aws logs tail /aws/lambda/bank-statement-processor --follow",
    "lambda:test": "aws lambda invoke --function-name bank-statement-processor response.json && type response.json",
    "lambda:test:bash": "aws lambda invoke --function-name bank-statement-processor response.json && cat response.json"
  },
  "keywords": [
    "bank",
    "automation",
    "email",
    "pdf",
    "credit-card"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.927.0",
    "@notionhq/client": "^5.3.0",
    "dotenv": "^16.4.5",
    "googleapis": "^165.0.0",
    "imap": "^0.8.19",
    "mailparser": "^3.7.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
