# =============================================================================
# Variables de Entorno para AWS Lambda Deployment
# =============================================================================
# Copia este archivo a .env.lambda y configura los valores antes de desplegar
# Este archivo es usado por el script de deployment (infrastructure/deploy.ps1)
# =============================================================================

# =============================================================================
# Configuración de Gmail
# =============================================================================

# Tu dirección de email de Gmail
EMAIL_USER=tu_email@gmail.com

# Usar OAuth2 (recomendado, debe ser "true")
USE_OAUTH2=true

# Credenciales OAuth2 de Google Cloud Console
# Consulta OAUTH2_SETUP.md para obtener estas credenciales
GMAIL_OAUTH2_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GMAIL_OAUTH2_CLIENT_SECRET=tu_client_secret

# =============================================================================
# Configuración del Banco
# =============================================================================

# Remitentes del banco (separados por comas si son varios)
# Ejemplo: email1@banco.com,email2@banco.com
BANK_EMAIL_SENDERS=estado.decuenta@no-responder.bancopromerica.com.gt,estado.decuenta@bancopromerica.com.gt

# Palabras clave para identificar estados de cuenta (separadas por comas)
EMAIL_SUBJECT_KEYWORDS=estado de cuenta,state,tarjeta de credito

# =============================================================================
# Configuración de Notion
# =============================================================================

# API Key de Notion (comienza con secret_)
# Para obtenerla: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_tu_api_key_de_notion

# ID de la base de datos de Notion donde guardar la información
# El ID está en la URL de tu base de datos: notion.so/[workspace]/[DATABASE_ID]?v=...
NOTION_DATABASE_ID=tu_database_id_de_notion

# =============================================================================
# Configuración de AWS (opcional, usa defaults si no se especifican)
# =============================================================================

# Región de AWS donde desplegar (default: us-east-1)
# AWS_REGION=us-east-1

# Expresión cron para el schedule de EventBridge
# Default: cron(0 * * * ? *) - cada hora
# Ejemplos:
#   - Cada hora: cron(0 * * * ? *)
#   - Cada 3 horas: cron(0 */3 * * ? *)
#   - Cada día a las 8am: cron(0 8 * * ? *)
# SCHEDULE_EXPRESSION=cron(0 * * * ? *)
